{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solari-cookbook/overnight-options-desk/signals.schema.json",
  "title": "Signals",
  "description": "Per-symbol quant outputs (GARCH vol forecast, OU mean-reversion stats, momentum) for one run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "per_symbol"],
  "properties": {
    "as_of": { "type": "string", "format": "date-time" },
    "per_symbol": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "garch_vol_forecast_1d",
          "garch_vol_forecast_ann",
          "ou_zscore",
          "ou_half_life_d",
          "momentum_5d",
          "verdict",
          "notes"
        ],
        "properties": {
          "garch_vol_forecast_1d": { "type": "number", "minimum": 0 },
          "garch_vol_forecast_ann": { "type": "number", "minimum": 0 },
          "ou_zscore": { "type": "number" },
          "ou_half_life_d": { "type": "number", "minimum": 0 },
          "momentum_5d": { "type": "number" },
          "verdict": {
            "type": "string",
            "enum": ["bullish", "bearish", "neutral", "avoid"]
          },
          "label": {
            "type": "string",
            "description": "Optional finer-grained research label (GRE-3464) — e.g. insufficient-data, mean-reversion-watch, trend-watch, event-risk, no-strong-signal. Omitted when a producer doesn't set one; consumers must not assume presence. Keeps the coarse `verdict` enum closed while letting the models lane's real vocabulary travel as data instead of only inside notes[] prose.",
            "enum": [
              "insufficient-data",
              "mean-reversion-watch",
              "trend-watch",
              "event-risk",
              "no-strong-signal"
            ]
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
